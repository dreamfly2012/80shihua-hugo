# ---- Hugo 构建产物(由 CI 生成, 不入库) ----
/public/
/resources/

# ---- 本地 Hugo 二进制(CI 自带) ----
/hugo_bin/
/hugo.zip

# ---- 迁移/下载脚本的临时缓存 ----
.image_urls_cache.txt
.ueditor_urls_cache.txt
image_scan.log
image_scan_report.json

# ---- Python ----
__pycache__/
*.pyc

# ---- 系统/编辑器 ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- 本地环境专属配置(各人不同, 不入库; 生产构建默认不读取) ----
# 目录化后: 共享基础配置在 config/_default/(入库); 本地覆盖在 config/local/(不入库)
config/local/

# ---- WorkBuddy 项目数据(非缓存, 但属本地工作目录, 不入库) ----
.workbuddy/

# 注意: static/uploads/ 下的图片是站点资源, 必须保留入库(部署时要一起发布)
